{
    "label" : "lock",
    "action": "hyprlock",
    "text"  : "Kilitle",
    "keybind": "k"
}
{
    "label" : "logout",
    "action": "hyprctl dispatch exit",
    "text"  : "Oturumu Kapat",
    "keybind": "o"
}
{
    "label" : "suspend",
    "action": "hyprlock & sleep 0.5; systemctl suspend",
    "text"  : "Uyku",
    "keybind": "u"
}
{
    "label" : "hibernate",
    "action": "hyprlock & sleep 0.5; systemctl hibernate",
    "text"  : "Hazırda Beklet",
    "keybind": "h"
}
{
    "label" : "reboot",
    "action": "systemctl reboot",
    "text"  : "Yeniden Başlat",
    "keybind": "y"
}
{
    "label" : "shutdown",
    "action": "systemctl poweroff",
    "text"  : "Kapat",
    "keybind": "p"
}

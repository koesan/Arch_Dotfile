// ═══════════════════════════════════════════════════════════════════════════
//  Waybar — Arch_Dotfile
//  Palet: Catppuccin Mocha (renkler style.css içinde)
//
//  İkonlar Nerd Font "Material Design" aralığından (U+F0xxx) seçildi.
//  Bu bilinçli bir tercih: Font Awesome'ın U+F0xx aralığı, sistemde
//  ttf-ms-fonts kuruluysa Webdings ile çakışıyor ve yanlış simge çiziliyor.
//  Material Design aralığında böyle bir çakışma yok.
//
//  Modül belgeleri:  man 5 waybar-<modül>   (ör. man 5 waybar-battery)
// ═══════════════════════════════════════════════════════════════════════════
{
    "layer": "top",
    "position": "top",
    "height": 34,
    // Modüller arası boşluk. style.css'teki `margin: 0 2px` ile toplanır;
    // sağ tarafta çok modül olduğu için düşük tutuluyor, yoksa panel
    // gereksiz yere geniş görünüyor.
    "spacing": 2,
    "margin-top": 4,
    "margin-left": 8,
    "margin-right": 8,

    // Yerleşim:
    //   sol   → açık uygulamalar (görev çubuğu) + çalan medya
    //   orta  → workspace ("sekme") göstergesi
    //   sağ   → durum modülleri; saat EN SAĞDA, pilin sağında
    // Not: "hyprland/submap" bilerek listede DEĞİL. Bu depodaki Lua
    // yapılandırmasında hiç submap tanımlanmıyor, dolayısıyla modül hiçbir
    // zaman bir şey göstermiyordu. Tanımı aşağıda duruyor: kendi submap'inizi
    // eklerseniz modül adını bu listeye geri yazmanız yeterli.
    // Not: odaklı pencerenin başlığını gösteren "hyprland/window" modülü
    // KALDIRILDI. Görev çubuğu zaten hangi pencerenin etkin olduğunu
    // (`#taskbar button.active`) işaretliyordu; başlık bunun üstüne 45
    // karaktere kadar değişken uzunlukta bir metin ekleyip ortadaki workspace
    // göstergesini sağa sola kaydırıyordu. Geri isterseniz modülü bu listeye
    // yazıp tanımını eklemeniz yeterli (man 5 waybar-hyprland-window).
    // Çalan medya SOLDA, görev çubuğunun hemen sağında duruyor: ikisi de
    // "şu an ne açık / ne oynuyor" bilgisi, aynı yerde toplanıyorlar.
    // Sağ taraf durum simgelerine (ses, ağ, pil, saat) ayrılmış durumda ve
    // zaten kalabalık; oraya 30+ karakterlik değişken uzunlukta bir metin
    // koymak workspace göstergesini ortadan kaydırıyordu.
    "modules-left":   ["wlr/taskbar", "mpris"],
    // Workspace göstergesi TEK modül değil, workspace başına bir "custom"
    // modül. Sebebi aşağıda `custom/ws1` bloğunda anlatılıyor: yerleşik
    // `hyprland/workspaces` modülünün tıklaması Hyprland'in Lua yapılandırma
    // biçiminde çalışmıyor.
    "modules-center": ["custom/ws1", "custom/ws2", "custom/ws3", "custom/ws4", "custom/ws5", "custom/ws6", "custom/ws7", "custom/ws8", "custom/ws9", "custom/ws10"],
    "modules-right":  [
        "custom/recording",
        "privacy",
        "custom/caffeine",
        "pulseaudio",
        "pulseaudio#mic",
        "bluetooth",
        "network",
        "backlight",
        "cpu",
        "memory",
        "temperature",
        "battery",
        "clock"
    ],

    // ───────────────────────────────────────────────────────────────────────
    // Sol
    // ───────────────────────────────────────────────────────────────────────

    // ───────────────────────────────────────────────────────────────────────
    //  Workspace göstergesi — custom/ws1 … custom/ws10
    // ───────────────────────────────────────────────────────────────────────
    //
    //  NEDEN YERLEŞİK `hyprland/workspaces` KULLANILMIYOR:
    //  O modül bir numaraya tıklandığında Hyprland soketine eski biçim bir
    //  komut yazar — `dispatch workspace 2`. Hyprland 0.56'dan itibaren,
    //  yapılandırma Lua biçimindeyse (bu depoda öyle: hyprland.lua) soketten
    //  gelen dispatch metni bir LUA İFADESİ olarak değerlendirilir:
    //
    //      return hl.dispatch(workspace 2)      ← geçersiz Lua, sözdizimi hatası
    //      return hl.dispatch(hl.dsp.focus({ workspace = 2 }))   ← doğrusu
    //
    //  Waybar bu yeni söz dizimini bilmiyor ve `hyprland/workspaces` modülünde
    //  komutu dışarıdan değiştirecek bir "on-click" seçeneği YOK
    //  (bkz. man 5 waybar-hyprland-workspaces). Bu yüzden tıklamalar sessizce
    //  hiçbir şey yapmıyordu. Kendiniz doğrulayabilirsiniz:
    //
    //      hyprctl dispatch workspace 1
    //      → error: [string "return hl.dispatch(workspace 1)"]:1: ')' expected
    //
    //  Çözüm: gösterge workspace başına bir `custom` modüle bölündü. Durumu ve
    //  tıklamayı ~/.local/bin/waybar-workspace üretiyor; o betik Lua biçimini
    //  kullanır, eski biçime de geri düşer (taşınabilirlik için).
    //
    //  DAVRANIŞ: betik boş çıktı verdiğinde waybar modülü hiç çizmez, yani
    //  yalnızca DOLU workspace'ler (artı odaklı olan) görünür — yerleşik
    //  modülün persistent-workspaces'sız davranışının aynısı.
    //
    //  GÜNCELLEME: saniyede bir yoklama YOK. Hyprland'in Lua yapılandırması
    //  (lua/waybar.lua) workspace/pencere olaylarında SIGRTMIN+9 gönderir;
    //  modüller yalnızca o an tazelenir. Sinyal numarası orada da aynı olmalı.
    //
    //  Kaç tane? Klavye kısayolları 1-10 arasını bağlıyor (lua/binds.lua),
    //  liste de onunla eşleşiyor. Daha azını istiyorsanız hem buradaki
    //  blokları hem de yukarıdaki "modules-center" listesini kısaltın.

    "custom/ws1": {
        "exec":        "$HOME/.local/bin/waybar-workspace 1",
        "return-type": "json",
        "interval":    "once",
        "signal":      9,
        "format":      "{}",
        "on-click":    "$HOME/.local/bin/waybar-workspace focus 1"
    },

    "custom/ws2": {
        "exec":        "$HOME/.local/bin/waybar-workspace 2",
        "return-type": "json",
        "interval":    "once",
        "signal":      9,
        "format":      "{}",
        "on-click":    "$HOME/.local/bin/waybar-workspace focus 2"
    },

    "custom/ws3": {
        "exec":        "$HOME/.local/bin/waybar-workspace 3",
        "return-type": "json",
        "interval":    "once",
        "signal":      9,
        "format":      "{}",
        "on-click":    "$HOME/.local/bin/waybar-workspace focus 3"
    },

    "custom/ws4": {
        "exec":        "$HOME/.local/bin/waybar-workspace 4",
        "return-type": "json",
        "interval":    "once",
        "signal":      9,
        "format":      "{}",
        "on-click":    "$HOME/.local/bin/waybar-workspace focus 4"
    },

    "custom/ws5": {
        "exec":        "$HOME/.local/bin/waybar-workspace 5",
        "return-type": "json",
        "interval":    "once",
        "signal":      9,
        "format":      "{}",
        "on-click":    "$HOME/.local/bin/waybar-workspace focus 5"
    },

    "custom/ws6": {
        "exec":        "$HOME/.local/bin/waybar-workspace 6",
        "return-type": "json",
        "interval":    "once",
        "signal":      9,
        "format":      "{}",
        "on-click":    "$HOME/.local/bin/waybar-workspace focus 6"
    },

    "custom/ws7": {
        "exec":        "$HOME/.local/bin/waybar-workspace 7",
        "return-type": "json",
        "interval":    "once",
        "signal":      9,
        "format":      "{}",
        "on-click":    "$HOME/.local/bin/waybar-workspace focus 7"
    },

    "custom/ws8": {
        "exec":        "$HOME/.local/bin/waybar-workspace 8",
        "return-type": "json",
        "interval":    "once",
        "signal":      9,
        "format":      "{}",
        "on-click":    "$HOME/.local/bin/waybar-workspace focus 8"
    },

    "custom/ws9": {
        "exec":        "$HOME/.local/bin/waybar-workspace 9",
        "return-type": "json",
        "interval":    "once",
        "signal":      9,
        "format":      "{}",
        "on-click":    "$HOME/.local/bin/waybar-workspace focus 9"
    },

    "custom/ws10": {
        "exec":        "$HOME/.local/bin/waybar-workspace 10",
        "return-type": "json",
        "interval":    "once",
        "signal":      9,
        "format":      "{}",
        "on-click":    "$HOME/.local/bin/waybar-workspace focus 10"
    },

    // Yalnızca modules-left listesine eklenirse çizilir (bkz. yukarıdaki not).
    "hyprland/submap": {
        "format": "󰌆 {}",
        "tooltip": false
    },

    // ───────────────────────────────────────────────────────────────────────
    // Orta
    // ───────────────────────────────────────────────────────────────────────

    "clock": {
        "interval": 1,
        "format": "󰥔 {:%H:%M}",
        // Tıklayınca tarihe geçer, tekrar tıklayınca saniyeli saate.
        "format-alt": "󰃭 {:%d.%m.%Y %A}",
        "tooltip-format": "<big>{:%B %Y}</big>\n<tt><small>{calendar}</small></tt>",
        "calendar": {
            "mode": "month",
            "weeks-pos": "right",
            "on-scroll": 1,
            "format": {
                "months":   "<span color='#cdd6f4'><b>{}</b></span>",
                "days":     "<span color='#bac2de'>{}</span>",
                "weeks":    "<span color='#94e2d5'><b>H{}</b></span>",
                "weekdays": "<span color='#f9e2af'><b>{}</b></span>",
                "today":    "<span color='#89b4fa'><b><u>{}</u></b></span>"
            }
        },
        "actions": {
            "on-click-right": "mode",
            "on-scroll-up":   "shift_up",
            "on-scroll-down": "shift_down"
        }
    },

    // ───────────────────────────────────────────────────────────────────────
    // Sağ
    // ───────────────────────────────────────────────────────────────────────

    // Ekran/mikrofon/kamera kullanımda olduğunda uyarır.
    // Toplantı veya kayıt sırasında neyin paylaşıldığını görmek için.
    "privacy": {
        "icon-spacing": 6,
        "icon-size": 13,
        "transition-duration": 200,
        "modules": [
            { "type": "screenshare", "tooltip": true, "tooltip-icon-size": 20 },
            { "type": "audio-in",    "tooltip": true, "tooltip-icon-size": 20 }
        ]
    },

    // Çalan medya (MPRIS) — YALNIZCA bir şey çalarken/duraklatılmışken görünür.
    //
    // Kaynak MPRIS'tir, yani yalnızca müzik çalarlar değil TARAYICIDAKİ medya
    // da görünür: Brave/Chromium/Firefox'ta açılan YouTube, Spotify Web ya da
    // herhangi bir video sitesi kendini MPRIS ile duyurur. mpv, VLC, Spotify
    // masaüstü uygulaması da aynı listeye girer.
    //
    // Birden çok oynatıcı varsa waybar "playerctld" üzerinden EN SON
    // kullanılanı gösterir; hepsini ayrı ayrı göstermez.
    //
    // Metin bilerek kısıtlı: başlık + sanatçı, en çok 34 karakter. Solda
    // pencere başlığıyla yan yana durduğu için ikisi birden uzarsa ortadaki
    // workspace göstergesi kayar. Tamamı fareyle üzerine gelince görünür.
    //
    // Tıklama: sol = oynat/duraklat, sağ = sonraki, orta = önceki
    // (waybar'ın yerleşik davranışı; ayrıca komut yazmak gerekmez).
    "mpris": {
        "format":            "{player_icon} {dynamic}",
        "format-paused":     "{status_icon} {dynamic}",
        "dynamic-order":     ["title", "artist"],
        "dynamic-separator": "  ·  ",
        "dynamic-len":       28,
        "title-len":         28,
        "artist-len":        16,
        "max-length":        34,
        "player-icons": {
            "default":  "󰝚",
            "brave":    "󰖟",
            "chromium": "󰊯",
            "firefox":  "󰈹",
            "mpv":      "󰐹",
            "vlc":      "󰕼",
            "spotify":  "󰓇"
        },
        "status-icons": {
            "paused":  "󰏤",
            "stopped": "󰓛"
        },
        "tooltip-format": "{player} · {status}\n{title}\n{artist}\nSol tık: oynat/duraklat  ·  Sağ tık: sonraki"
    },

    // Ekran kaydı göstergesi — YALNIZCA kayıt sürerken görünür.
    //
    // Neden "privacy" modülü yetmiyor: o modül PipeWire üzerinden yapılan
    // ekran paylaşımını görür. wf-recorder ise ekranı doğrudan Wayland'in
    // screencopy protokolüyle alır, PipeWire'a hiç uğramaz; privacy kayıt
    // sırasında hiçbir şey göstermiyordu.
    //
    // Kayıt yokken betik boş çıktı verir ve waybar modülü hiç çizmez.
    // Yoklama yok: betik başlat/durdur anında SIGRTMIN+10 gönderir; sinyal
    // numarası configs/bin/screenrecord içindeki SIGNAL ile aynı olmalı.
    // Tıklamak kaydı durdurur (CTRL+PRINT ile aynı iş).
    "custom/recording": {
        "exec":        "$HOME/.local/bin/screenrecord status",
        "return-type": "json",
        "interval":    "once",
        "signal":      10,
        "format":      "{}",
        "on-click":    "$HOME/.local/bin/screenrecord stop"
    },

    // Kahve düğmesi — açıkken ekran kararmaz, kilitlenmez, uyumaz.
    //
    // Waybar'ın YERLEŞİK "idle_inhibitor" modülü burada BİLEREK kullanılmıyor.
    // O modül durumu yalnızca bellekte tutar: waybar her yeniden başladığında
    // (config değişikliği, oturum açılışı, `killall waybar`) sessizce kapalıya
    // döner. Kullanıcı düğmeyi açık sanırken ekran 5 dakikada kararıyordu.
    //
    // ~/.local/bin/caffeine durumu $XDG_RUNTIME_DIR/caffeine dosyasında tutar;
    // hypridle'daki her listener `condition_cmd` ile o dosyaya bakar. Betik
    // ayrıca bir systemd idle:sleep kilidi alır — iki bağımsız katman.
    //
    // "interval": "once" + "signal": 8 → modül yalnızca açılışta ve betik
    // SIGRTMIN+8 gönderdiğinde çalışır; saniyede bir süreç başlatmaz.
    // Sinyal numarası betikteki SIGNAL değişkeniyle aynı olmalıdır.
    //
    // Betik kurulu değilse komut başarısız olur, modül boş metin döndürür ve
    // waybar onu hiç çizmez — panel yine açılır.
    "custom/caffeine": {
        "exec":        "$HOME/.local/bin/caffeine status",
        "return-type": "json",
        "interval":    "once",
        "signal":      8,
        "format":      "{}",
        "on-click":    "$HOME/.local/bin/caffeine toggle"
    },

    "pulseaudio": {
        // Eski config burada <span font_desc='Font Awesome 6 ...'> kullanıyordu.
        // Sistemde Font Awesome 7 kurulu olduğu için o span'lar eşleşmiyor ve
        // simgeler bozuk çiziliyordu. Artık font yalnızca style.css'te tanımlı.
        "format":              "{icon} {volume}%",
        "format-bluetooth":    "󰂰 {volume}%",
        "format-bluetooth-muted": "󰝟 {volume}%",
        "format-muted":        "󰝟 Sessiz",
        "format-icons": {
            "headphone":  "󰋋",
            "headset":    "󰋎",
            "hands-free": "󰋎",
            "phone":      "󰏲",
            "portable":   "󰄝",
            "car":        "󰄋",
            "hdmi":       "󰡁",
            "default":    ["󰕿", "󰖀", "󰕾"]
        },
        "scroll-step": 5,
        "on-click":        "pavucontrol",
        "on-click-right":  "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
        "tooltip-format":  "{desc}\n{volume}%"
    },

    // Mikrofon. Aynı pulseaudio modülünün ikinci bir örneği ("#mic" son eki);
    // waybar bunu ayrı bir modül gibi çizer ve style.css'te
    // `#pulseaudio.mic` seçicisiyle ayrı renklendirilebilir.
    //
    // Yalnızca AÇIK/KAPALI durumu gösterilir, yüzde YOK: "{format_source}"
    // modülün tamamının çıktısını kaynağın (mikrofonun) durumuna indirger.
    //   açık   → 󰍬
    //   kapalı → 󰍭   (üstü çizili mikrofon, style.css'te soluk renkte)
    // Yüzde de isterseniz format-source'u "󰍬  {volume}%" yapın.
    "pulseaudio#mic": {
        "format":               "{format_source}",
        // Kapalıyken renk CSS ile verilemiyor: waybar mikrofon için ayrı bir
        // stil sınıfı üretmiyor (#pulseaudio.muted yalnızca HOPARLÖR susunca
        // ekleniyor). Bu yüzden renk doğrudan Pango işaretlemesiyle veriliyor.
        // #f38ba8 = Catppuccin Mocha "red" (style.css'teki @red ile aynı).
        "format-source":        "󰍬",
        "format-source-muted":  "<span color='#f38ba8'>󰍭</span>",
        "on-click":             "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
        "on-click-right":       "pavucontrol -t 4",
        "tooltip-format":       "Mikrofon: {source_desc}  ·  {source_volume}%\nTıkla: aç/kapat"
    },

    "bluetooth": {
        "format":              "󰂯",
        "format-disabled":     "󰂲",
        "format-off":          "󰂲",
        "format-connected":    "󰂱 {num_connections}",
        "tooltip-format":              "{controller_alias}",
        "tooltip-format-connected":    "{controller_alias}\n{device_enumerate}",
        "tooltip-format-enumerate-connected": "{device_alias}",
        "on-click":       "blueman-manager",
        "on-click-right": "bluetoothctl power off"
    },

    "network": {
        // Eski config'te "format": "" tanımlıydı ve min/max-length 17'ye
        // sabitlenmişti; uzun SSID'ler ortadan kesiliyordu. Artık her durum
        // için ayrı format var ve genişlik içeriğe göre ayarlanıyor.
        "interval": 5,
        "format-wifi":         "{icon} {essid}",
        "format-ethernet":     "󰈀 {ifname}",
        "format-linked":       "󰈀 {ifname} (IP yok)",
        "format-disconnected": "󰤭 Bağlı değil",
        "format-icons":        ["󰤟", "󰤢", "󰤥", "󰤨"],
        "max-length": 22,
        "tooltip-format-wifi":     "{essid} ({signalStrength}%)\n{ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-ethernet": "{ifname}\n{ipaddr}/{cidr}\n↓ {bandwidthDownBytes}  ↑ {bandwidthUpBytes}",
        "tooltip-format-disconnected": "Ağ bağlantısı yok",
        "on-click": "alacritty --class nmtui -e nmtui"
    },

    "backlight": {
        // Cihaz adı verilmezse waybar otomatik seçer; bu makinede amdgpu_bl2.
        // Farklı bir makinede çalışması için sabitlenmedi.
        "format": "{icon} {percent}%",
        "format-icons": ["󰃞", "󰃟", "󰃠"],
        "scroll-step": 5,
        "tooltip-format": "Parlaklık {percent}%"
    },

    "cpu": {
        "interval": 3,
        "format": "󰻠 {usage}%",
        "states": { "warning": 70, "critical": 90 },
        "on-click": "alacritty -e btop",
        "tooltip-format": "CPU {usage}%  ·  {avg_frequency} GHz  ·  yük {load}"
    },

    "memory": {
        // Eski config'te "exec" ve "exec-tooltip" anahtarları vardı; memory
        // modülünde böyle bir seçenek yok, sessizce yok sayılıyorlardı.
        // Aynı bilgi modülün kendi değişkenleriyle veriliyor.
        "interval": 5,
        "format": "󰍛 {percentage}%",
        "states": { "warning": 75, "critical": 90 },
        "on-click": "alacritty -e btop",
        "tooltip-format": "RAM  {used:0.1f} / {total:0.1f} GiB\nSwap {swapUsed:0.1f} / {swapTotal:0.1f} GiB"
    },

    "temperature": {
        // ÖNEMLİ — bu blok makineye özeldir ve kurulum betiği tarafından
        // otomatik doldurulur (setup_waybar_sensor). Depoda hiçbir yol
        // YAZMIYOR; donanıma bağlı değer kurulum anında eklenir.
        //
        // YAZILAN ANAHTARLAR: "hwmon-path-abs" + "input-filename".
        // Tek başına "hwmon-path" KULLANILMIYOR, çünkü o yol
        //     /sys/devices/pci0000:00/0000:00:18.3/hwmon/hwmon3/temp1_input
        // biçimindedir ve içindeki hwmonN numarası SÜRÜCÜLERİN YÜKLENME
        // SIRASINA göre her açılışta değişebilir. Numara kaydığında waybar ya
        // hiçbir şey okuyamaz ya da başka bir çipi (NVMe SSD, GPU) CPU diye
        // gösterir — panelde "yanlış sıcaklık" olarak görünen tam olarak budur.
        // "hwmon-path-abs" ise cihazın SABİT PCI yolunu alır ve hwmonN alt
        // dizinini waybar çalışma anında kendisi bulur:
        //     "hwmon-path-abs": "/sys/devices/pci0000:00/0000:00:18.3/hwmon",
        //     "input-filename": "temp1_input"
        //
        // DİKKAT: waybar hiçbir hwmon anahtarı yoksa
        // /sys/class/thermal/thermal_zone0 üzerinden okur — ve o dosya her
        // makinede YOKTUR (ör. bu depoyu geliştiren makinede /sys/class/thermal
        // yalnızca cooling_device* içeriyor). O durumda waybar modülü sessizce
        // devre dışı bırakır. Kurulum betiği bu yüzden sırayla k10temp /
        // zenpower / coretemp → acpitz → herhangi bir hwmon girdisi arar.
        //
        // Kendi yolunuzu görmek için:
        //   for i in /sys/class/hwmon/hwmon*/temp*_input; do \
        //     echo "$(cat "$(dirname "$i")"/name) -> $i"; done

        // EŞİKLER — panelin sarı/kırmızıya dönme noktaları.
        // Eskiden 70/85 yazıyordu. Bu değerler bir MASAÜSTÜ için bile düşük,
        // dizüstü için tamamen yanlış: modern bir CPU'nun kritik sıcaklığı
        // (Tjmax) 100-105 °C'dir ve işlemci oraya varmadan kendini kısmaz.
        // AMD'nin Tctl sensörü ayrıca çok kıpırdaktır — tek bir çekirdek bir
        // anlığına turbo yapınca okuma 80'i geçip hemen 50'lere döner. 70/85
        // eşikleriyle panel sürekli sarı/kırmızı yanıyor, makine "çok
        // ısınıyor" gibi görünüyordu; oysa boştaki gerçek değer 45-55 °C.
        // 85/95 sınırları gerçek bir sorunu (soğutucu tıkalı, fan durmuş)
        // hâlâ yakalar, normal turbo sıçramalarını yakalamaz.
        "warning-threshold": 85,
        "critical-threshold": 95,

        // 5 sn yerine 10 sn: yukarıdaki kıpırdaklık yüzünden daha sık okumak
        // yalnızca panelde zıplayan bir sayı üretiyor, bilgi katmıyor.
        "interval": 10,
        "format": "{icon} {temperatureC}°C",
        "format-icons": ["󰔏", "󰔐", "󰸁"],
        "tooltip-format": "CPU sıcaklığı {temperatureC}°C",
        "on-click": "alacritty -e btop"
    },

    "battery": {
        "interval": 10,
        "states": { "warning": 25, "critical": 10 },
        "format":          "{icon} {capacity}%",
        "format-charging": "󰂄 {capacity}%",
        "format-plugged":  "󰚥 {capacity}%",
        "format-full":     "󰁹 Dolu",
        "format-icons":    ["󰁺", "󰁻", "󰁼", "󰁽", "󰁾", "󰁿", "󰂀", "󰂁", "󰂂", "󰁹"],
        "format-time":     "{H}s {M}dk",
        "tooltip-format":  "{capacity}%  ·  {power:0.1f} W\nKalan: {time}\nSağlık: {health}%  ·  {cycles} döngü\nTıkla: güç profili seç",

        // Pil simgesine tıklamak GÜÇ PROFİLİ menüsünü açar (Performans /
        // Dengeli / Tasarruf), geçerli profil ● ile işaretli gelir.
        //
        // Waybar'ın yerleşik "power-profiles-daemon" modülü bilerek
        // kullanılmıyor: o modül tıklamada profilleri sırayla değiştirir,
        // yani istediğiniz profile varmak için birkaç kez tıklamak gerekir.
        // Ayrıca panelde bir modül daha yer kaplardı.
        //
        // Fiş takılıp çekildiğinde profil zaten kendiliğinden değişir
        // (performans / tasarruf) — bkz. configs/bin/powerprofile ve
        // configs/systemd/powerprofile-auto.timer.
        "on-click": "$HOME/.local/bin/powerprofile menu"
    },

    // Sistem tepsisi — BİLEREK "modules-right" listesinde DEĞİL.
    //
    // Bu masaüstünde tepsiyi kullanan uygulama yok. Tek istisna Claude Desktop
    // idi ve o da geçerli bir simge yayımlamıyor; waybar günlüğüne
    //     Item 'Claude_status_icon_1': No icon name or pixmap given.
    // yazıp yerine "eksik görsel" yer tutucusunu (üstü çizili daire) çiziyordu.
    // Panelde sıcaklıkla pil arasında görünen o anlamsız işaret buydu;
    // tıklandığında Claude Desktop penceresini açıyordu.
    //
    // Tepsiye ihtiyaç duyan bir uygulama kurarsanız (blueman-applet, nm-applet,
    // Telegram, Steam ...) modül adını "modules-right" listesine geri yazmanız
    // yeterli. Bozuk simge yayımlayan bir uygulamaya elle simge vermek de
    // mümkündür:  "icons": { "Uygulama_Id": "simge-adi" }
    "tray": {
        "icon-size": 16,
        // Simgeler arası boşluk. 10 px'te tepside iki-üç simge varken kutu
        // gereksiz genişliyordu.
        "spacing": 6,
        "show-passive-items": true
    },

    // ───────────────────────────────────────────────────────────────────────
    // Görev çubuğu — panelin SOL ucu
    // ───────────────────────────────────────────────────────────────────────
    // Açık olan her pencere burada bir simge olarak durur. Yalnızca simge
    // gösteriliyor ("{icon}"): başlıklar da yazılsaydı birkaç pencerede panel
    // dolup workspace göstergesini ortadan kaydırırdı. Başlığı fareyle üzerine
    // gelince ipucu olarak görürsünüz.
    //
    // "icon-theme" satırını kurulum betiği gerçekten kurulu simge temasına
    // göre güncellemez; tema bulunamazsa waybar sistem varsayılanına düşer ve
    // simgeler yine çizilir.
    "wlr/taskbar": {
        "format": "{icon}",
        "icon-size": 18,
        "icon-theme": "dracula-icons-main",
        "tooltip-format": "{title}",
        "on-click": "activate",
        "on-click-middle": "close",
        "on-click-right": "fullscreen",
        // Boş bir pencere listesi olduğunda kutu hiç çizilmesin.
        "ignore-list": []
    }
}

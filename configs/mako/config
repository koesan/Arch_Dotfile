# ═══════════════════════════════════════════════════════════════════════════
#  mako — bildirim daemon'u
#  Palet: Catppuccin Mocha
#
#  Not: Eski kurulumda hyprland.conf mako'yu başlatmaya çalışıyordu ama paket
#  kurulu değildi; bu yüzden HİÇBİR bildirim görünmüyordu. Artık kurulum
#  betiğinin paket listesinde.
#
#  Komutlar:
#    makoctl dismiss --all     tümünü kapat        (SUPER+N)
#    makoctl restore           sonuncuyu geri getir (SUPER+SHIFT+N)
#    makoctl reload            bu dosyayı yeniden oku
#    makoctl list              bekleyen bildirimler
#
#  Tüm seçenekler:  man 5 mako
# ═══════════════════════════════════════════════════════════════════════════

# ── Konum ve boyut ─────────────────────────────────────────────────────────
# Waybar üstte 34px + 4px margin; bildirimler onun altından başlasın.
anchor=top-right
margin=10,14,10
outer-margin=48,10,10

width=380
height=160
padding=14
border-size=2
border-radius=12

# ── Yazı ───────────────────────────────────────────────────────────────────
font=JetBrainsMono Nerd Font 10
markup=1
format=<b>%s</b>\n%b
# Uzun bildirimlerde metni kırp, pencereyi büyütme.
max-visible=5
layer=overlay

# ── Renkler (Catppuccin Mocha) ─────────────────────────────────────────────
background-color=#181825f2
text-color=#cdd6f4
border-color=#313244
progress-color=over #313244

# ── Simgeler ───────────────────────────────────────────────────────────────
icons=1
max-icon-size=64
icon-location=left
# icon-path MUTLAK yol ister ve ~ genişletmesi YAPMAZ.
#
# Eski değer /usr/share/icons/dracula-icons-main idi; oysa dracula simgeleri
# ~/.icons altına kuruluyor — yani yol hiçbir zaman tutmuyordu ve bildirimlerde
# uygulama simgesi görünmüyordu. Kurulum betiği (setup_mako) bu satırı gerçek
# $HOME ve kurulu simge temasının adıyla yeniden yazar.
#
# Aşağıdaki liste, betik çalıştırılmasa bile geçerli olan güvenli varsayılandır:
# hicolor ve Adwaita her Arch kurulumunda vardır.
icon-path=/usr/share/icons/Adwaita:/usr/share/icons/hicolor

# ── Davranış ───────────────────────────────────────────────────────────────
default-timeout=5000
ignore-timeout=0
# Fare ile tıklayınca kapansın, sağ tık ile tümü kapansın.
on-button-left=dismiss
on-button-middle=none
on-button-right=dismiss-all
on-touch=dismiss

# Aynı uygulamadan arka arkaya gelen bildirimleri tek satırda topla.
group-by=app-name

# ═══════════════════════════════════════════════════════════════════════════
#  Öncelik kuralları
# ═══════════════════════════════════════════════════════════════════════════

# Düşük öncelik: daha sönük, daha kısa süre.
[urgency=low]
border-color=#45475a
text-color=#a6adc8
default-timeout=3000

# Normal öncelik: varsayılan vurgu rengi.
[urgency=normal]
border-color=#89b4fa

# Kritik: kırmızı kenarlık ve KENDİLİĞİNDEN KAPANMAZ.
# Pil bitmek üzere / disk dolu gibi uyarıları kaçırmamak için.
[urgency=critical]
border-color=#f38ba8
text-color=#f38ba8
default-timeout=0

# Gizli mod: `makoctl mode -a do-not-disturb` ile açılır, `-r` ile kapanır.
[mode=do-not-disturb]
invisible=1

# Ekran kilitliyken bildirim içeriği görünmesin.
[mode=lock]
format=<b>%s</b>
icons=0
